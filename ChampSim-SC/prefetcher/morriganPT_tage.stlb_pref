#include "cache.h"
#include "morriganPT.h"
#include <cmath>
#include <vector>   
#include <algorithm>
#include <random>
#include <deque>

// ─────────────────────────────────────────────────────────────────────────────
// Original Morrigan IRIP tables (unchanged from paper)
// ─────────────────────────────────────────────────────────────────────────────
MARKOV_S1 irip_s1[(int)pow(2.0, ceil(log2(PT_S1_SETS/PT_S1_ASSOC)))][PT_S1_ASSOC];
MARKOV_S2 irip_s2[(int)pow(2.0, ceil(log2(PT_S2_SETS/PT_S2_ASSOC)))][PT_S2_ASSOC];
MARKOV_S4 irip_s4[(int)pow(2.0, ceil(log2(PT_S4_SETS/PT_S4_ASSOC)))][PT_S4_ASSOC];
MARKOV_S8 irip_s8[(int)pow(2.0, ceil(log2(PT_S8_SETS/PT_S8_ASSOC)))][PT_S8_ASSOC];

uint64_t s_timer;
uint64_t previous_vpn;

// ─────────────────────────────────────────────────────────────────────────────
// T-IRIP: TAGE-inspired history tables (OUR NOVEL CONTRIBUTION)
//
// Design:
//   Three tables indexed by different history lengths (H2, H4, H8).
//   Index = hash32(partial_vpn XOR folded_history(N))
//   Tag   = hash32(partial_vpn XOR (folded_history(N) >> 3)) & TAG_MASK
//   Selection: longest matching history wins (H8 > H4 > H2)
//   Confidence >= 1 required to issue prefetch
//   Falls back to original IRIP if no TAGE table matches
// ─────────────────────────────────────────────────────────────────────────────

// T-IRIP table sizes
#define THT_H2_SETS  128
#define THT_H2_ASSOC 4
#define THT_H4_SETS  128
#define THT_H4_ASSOC 4
#define THT_H8_SETS  64
#define THT_H8_ASSOC 4

// Maximum history length to track
#define TAGE_MAX_HIST 8

// Number of history tables and their history lengths.
// Table t is indexed with a fingerprint of the last TAGE_HLEN[t] missed VPNs.
#define TAGE_NTAB 3
static const int TAGE_HLEN[TAGE_NTAB] = {2, 4, 8};

// Minimum confidence required to issue a prefetch (0..TAGE_CONF_MAX)
#define TAGE_CONF_THRESHOLD 1
#define TAGE_CONF_MAX       3

// T-IRIP table entry
class TAGE_ENTRY {
public:
    uint64_t tag;        // partial tag for collision detection
    int64_t  delta;      // predicted successor delta
    int      confidence; // saturating counter (0-3)
    uint64_t timestamp;  // for LRU replacement
    bool     valid;      // FIX #3: explicit valid bit (delta==0 is a legal delta)
    TAGE_ENTRY() : tag(0), delta(0), confidence(0), timestamp(0), valid(false) {}
};

// T-IRIP tables
TAGE_ENTRY tht_h2[(int)pow(2.0, ceil(log2(THT_H2_SETS/THT_H2_ASSOC)))][THT_H2_ASSOC];
TAGE_ENTRY tht_h4[(int)pow(2.0, ceil(log2(THT_H4_SETS/THT_H4_ASSOC)))][THT_H4_ASSOC];
TAGE_ENTRY tht_h8[(int)pow(2.0, ceil(log2(THT_H8_SETS/THT_H8_ASSOC)))][THT_H8_ASSOC];

// Miss history register: stores last TAGE_MAX_HIST missed VPNs
// history_reg[0] = most recent miss
uint64_t history_reg[TAGE_MAX_HIST];
int      history_len = 0;  // how many entries are valid

// ─────────────────────────────────────────────────────────────────────────────
// FIX #1 (the important one): train/lookup key carry-over.
//
// A T-IRIP entry must be TRAINED with exactly the same (index, tag) that a
// LOOKUP for that same VPN would compute. The lookup for VPN X happens at the
// top of stlb_prefetcher_operate() while X is the *current* miss, i.e. with a
// history register that does NOT yet contain X. The training for X happens one
// invocation later, when the successor delta is known.
//
// The buggy version recomputed the key at training time, by which point X had
// already been pushed into history_reg[0] -- so the training key folded X into
// its own history fingerprint and never matched the lookup key. Result: 0.27%
// hit rate across 45 traces.
//
// ─────────────────────────────────────────────────────────────────────────────
int      pend_idx[TAGE_NTAB]   = {-1, -1, -1};  // index used when prev_vpn was looked up
uint64_t pend_tag[TAGE_NTAB]   = {0, 0, 0};     // tag   used when prev_vpn was looked up
int      pend_ok[TAGE_NTAB]    = {0, 0, 0};     // was that table eligible at the time?
int      pend_valid            = 0;             // is there a pending (prev) key at all?

// Which table (if any) supplied the last prediction, and what it predicted.
// Used only for the accuracy statistics below.
int64_t  last_pred_delta = 0;
int      last_pred_tab   = -1;

// Statistics for T-IRIP
uint64_t tage_predictions  = 0;
uint64_t irip_predictions  = 0;
uint64_t total_istlb_misses = 0;
uint64_t tage_tab_pred[TAGE_NTAB] = {0, 0, 0};  // predictions issued, per table
uint64_t tage_tab_corr[TAGE_NTAB] = {0, 0, 0};  // of those, delta turned out right
uint64_t tage_correct  = 0;   // total correct T-IRIP predictions
uint64_t tage_installs = 0;   // new entries installed
uint64_t tage_evicts   = 0;   // installs that displaced a valid entry

// ─────────────────────────────────────────────────────────────────────────────
// Original Morrigan helper functions (unchanged)
// ─────────────────────────────────────────────────────────────────────────────
void show_s1(){
    int x = PT_S1_SETS / PT_S1_ASSOC;
    for(int i=0; i<x; ++i){
        for(int j=0; j<PT_S1_ASSOC; ++j){
            cout << hex << irip_s1[i][j].vpn << ", " << irip_s1[i][j].successor_delta << " | ";
        }
        cout << endl;
    }
}

void show_s2(){
    int x = PT_S2_SETS / PT_S2_ASSOC;
    for(int i=0; i<x; ++i){
        for(int j=0; j<PT_S2_ASSOC; ++j){
            cout << hex << irip_s2[i][j].vpn << ", " << irip_s2[i][j].successor_delta[0] << ", " <<  irip_s2[i][j].successor_delta[1] << " | ";
        }
        cout << endl;
    }
}

